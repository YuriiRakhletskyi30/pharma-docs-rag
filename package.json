{
  "name": "pharma-docs-rag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "fetch-labels": "tsx scripts/fetch-labels.ts",
    "build-seed": "node --env-file-if-exists=.env --import tsx scripts/build-seed.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval.ts",
    "check-env": "node --env-file-if-exists=.env --import tsx scripts/check-env.ts",
    "release": "node --env-file-if-exists=.env --import tsx scripts/release.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/react": "^4.0.186",
    "ai": "^7.0.181",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.1.0",
    "tsx": "^4.23.15",
    "unpdf": "^2.2.2",
    "voyage-ai-provider": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "engines": {
    "node": ">=24.18 <25"
  }
}
