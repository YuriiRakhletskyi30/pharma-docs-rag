# Required: answers (claude-sonnet-5-5) and follow-up rewriting (claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Optional: embeddings (voyage-4) and reranking (rerank-3).
# Without it the app runs keyword search only and shows a banner.
# Keys without a payment method on file are limited to 3 requests/min by Voyage.
VOYAGE_API_KEY=

# Uploaded PDFs become sources for every user. On for local use; leave unset (off) on a shared server.
ALLOW_UPLOADS=true

# Only needed when running outside docker compose (compose sets it for the app container)
# DATABASE_URL=postgres://rag:rag@localhost:5433/rag

# Request limits (per app instance). TRUST_PROXY=true only behind a proxy that sets X-Forwarded-For.
# QUESTIONS_PER_MIN_PER_CLIENT=10
# QUESTIONS_PER_MIN_TOTAL=60
# UPLOADS_PER_HOUR_PER_CLIENT=5
# TRUST_PROXY=false

# pino log level: trace, debug, info, warn, error
# LOG_LEVEL=info

# Host port for the app in docker compose (default 3000)
# APP_PORT=3000
